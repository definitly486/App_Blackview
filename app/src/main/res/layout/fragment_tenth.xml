<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">



    <TextView
        android:id="@+id/buildTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/loading"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/versionNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Версия приложения: загружается..."
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/buildTimeText"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/branchText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ветка Git: неизвестно"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/versionNameText"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- НОВАЯ СТРОКА: номер (хэш) коммита -->
    <TextView
        android:id="@+id/commitHashText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Коммит: неизвестно"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/branchText"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>