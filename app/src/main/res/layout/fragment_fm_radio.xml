<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FM Radio"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fmFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="87.5 MHz"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Выключено"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/fmFrequencySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="1050"
            android:progress="0" />

        <Button
            android:id="@+id/fmPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ВКЛЮЧИТЬ FM" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fmMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="−0.1" />

            <Button
                android:id="@+id/fmPrev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SEEK −" />

            <Button
                android:id="@+id/fmNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SEEK +" />

            <Button
                android:id="@+id/fmPlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+0.1" />
        </LinearLayout>

        <Button
            android:id="@+id/fmScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Автосканирование" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="На Blackview FM может требовать проводные наушники как антенну. После включения радио продолжает работать в фоне и на заблокированном экране."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
