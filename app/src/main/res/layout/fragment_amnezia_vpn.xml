<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amnezia VPN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/amneziaStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="● VPN отключён"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/amneziaConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Конфигурация не выбрана"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/amneziaOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Открыть конфигурацию .conf" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/amneziaConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подключиться" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/amneziaDisconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отключиться"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>
